{
  "name": "browser-extention-yap",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Cross-browser WebExtension for YAP UI customization.",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "postinstall": "wxt prepare",
    "clean": "node ./scripts/clean.mjs",
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "dev:edge": "wxt -b edge",
    "dev:opera": "wxt -b opera",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:commits": "commitlint --from HEAD~1 --to HEAD",
    "build": "node ./scripts/build-all.mjs",
    "build:chrome": "wxt build -b chrome",
    "build:firefox": "wxt build -b firefox",
    "build:edge": "wxt build -b edge",
    "build:opera": "wxt build -b opera",
    "build:safari": "wxt build -b safari",
    "zip": "node ./scripts/zip-all.mjs",
    "zip:chrome": "wxt zip -b chrome",
    "zip:firefox": "wxt zip -b firefox",
    "zip:edge": "wxt zip -b edge",
    "zip:opera": "wxt zip -b opera",
    "lint:firefox": "web-ext lint --source-dir .output/firefox-mv3 --warnings-as-errors",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "package:safari": "bash ./scripts/package-safari.sh",
    "submit:init": "wxt submit init",
    "submit:stores": "wxt submit",
    "release:ci": "node ./scripts/run-semantic-release.mjs",
    "release:dry-run": "semantic-release --dry-run"
  },
  "dependencies": {
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@eslint/js": "^10.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "@types/node": "^24.1.0",
    "eslint": "^10.4.0",
    "globals": "^17.6.0",
    "semantic-release": "^25.0.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.59.4",
    "vitest": "^3.2.4",
    "web-ext": "^8.10.0",
    "wxt": "^0.20.26"
  }
}
