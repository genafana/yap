{
  "name": "browser-extention-yap",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cross-browser WebExtension for YAP UI customization.",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "postinstall": "wxt prepare",
    "clean": "node ./scripts/clean.mjs",
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "dev:edge": "wxt -b edge",
    "dev:opera": "wxt -b opera",
    "build": "node ./scripts/build-all.mjs",
    "build:chrome": "wxt build -b chrome",
    "build:firefox": "wxt build -b firefox",
    "build:edge": "wxt build -b edge",
    "build:opera": "wxt build -b opera",
    "build:safari": "wxt build -b safari",
    "zip": "node ./scripts/zip-all.mjs",
    "zip:chrome": "wxt zip -b chrome",
    "zip:firefox": "wxt zip -b firefox",
    "zip:edge": "wxt zip -b edge",
    "zip:opera": "wxt zip -b opera",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "package:safari": "bash ./scripts/package-safari.sh",
    "submit:init": "wxt submit init",
    "submit:stores": "wxt submit"
  },
  "dependencies": {
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@types/node": "^24.1.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4",
    "wxt": "^0.20.26"
  }
}
